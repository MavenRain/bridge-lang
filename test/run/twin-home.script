-- A call script for examples/twin.lang (S10 s2): side 0 (home). The pool price of three
-- deposits, the batch hash chain, seal at the stored bound, and the home refusals of
-- the attests of key 7 (test/run/twin-remote.script accepts them on side 1).
init 0u
1 0x00000000000000000000000000000000000000aa sideOf
1 0x00000000000000000000000000000000000000aa deposit 5u 6u 10u
2 0x00000000000000000000000000000000000000aa deposit 7u 8u 10u
3 0x00000000000000000000000000000000000000aa deposit 9u 10u 10u
4 0x00000000000000000000000000000000000000aa rxOf
4 0x00000000000000000000000000000000000000aa ryOf
4 0x00000000000000000000000000000000000000aa seal

-- The next bound is 4 + 60, so a seal at 5 reverts.
5 0x00000000000000000000000000000000000000aa seal

-- Home enact reads the stored Decision word. The attest of the remote side does not open it.
6 0x00000000000000000000000000000000000000aa enact 1u 1u 100u 100u 13640322012419910779160519747081036978280854528525356142388876682012724302321u 18538714940515721848968265449014632110570653454278528879450713650630487487382u 0x2759611834b4be056e205b2eceaf0ca378dae9f3d2ce018e3b8fb78d5d92ab48u

-- Home accepts only an attest of side 1 (attestMsg 1u n h). This attest is of side 0.
7 0x00000000000000000000000000000000000000aa accept 0u 65464856881474182367233619130168970009212943138116352224957205723450756253912u 9961482077405933653703920413004101065199760487639777914203301284159532567165u 5862436715964027487145075334372980905100234227901145792980374837265196864691u 0x2f37d07c781626114905e47293f17b4a826ac21f377022f2817af4838c234647u
64 0x00000000000000000000000000000000000000aa seal
