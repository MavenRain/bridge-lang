-- A call script for examples/twin.lang (S10 s2): side 0 (home). The pool price of three
-- deposits, the batch hash chain, seal at the stored bound, and the home refusals of
-- the attests of key 7 (test/run/twin-remote.script accepts them on side 1).
init 0u
1 0x00000000000000000000000000000000000000aa sideOf
1 0x00000000000000000000000000000000000000aa deposit 3158628130809131474089875976652879399357254575535880020658385832492965979946u 9002457540433470152490850659345107267983836540995114289001868327279787047667u 10u
2 0x00000000000000000000000000000000000000aa deposit 21576012433999932920735124394921461927089194087037988485273198605798414207857u 16628399031297167549133710224180735038020239690938175651395637673254031640298u 10u
