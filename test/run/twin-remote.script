-- A call script for examples/twin.lang (S10 s2): side 1 (remote). Enact with the Schnorr
-- attest of key 7, accept the batch hash of test/run/twin-home.script with its attest,
-- then claim 0u from that batch. The words of the attests are in docs/STATUS.md (S10 s3).
init 1u
1 0x00000000000000000000000000000000000000aa sideOf
2 0x00000000000000000000000000000000000000aa enact 1u 1u 100u 100u 13640322012419910779160519747081036978280854528525356142388876682012724302321u 18538714940515721848968265449014632110570653454278528879450713650630487487382u 0x16c7db2f9518158af598a29100524e94c3f6f0040de3e355d901cfa8d41af243u

-- A proposal is enacted once.
