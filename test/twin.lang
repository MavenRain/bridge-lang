def e : Env := makeEnv 1 0x00000000000000000000000000000000000000aa
def acceptedResult : Option (Prod State (List Out)) -> Flag := fun (o : Option (Prod State (List Out))) => option flagNo (fun (p : Prod State (List Out)) => flagYes) o
def closeZero : Flag := acceptedResult (close e (init 0u) 1u 0u 0u 0u 1u 2u 0u 0u 13952815165197967125756980119533420968413717059059621486339195579699957758172u 0u 0u 1u 2u 0u 0u 14701443190095777811686243040802400733041311233058721930520713618723616718186u 0u)
def closeAlias : Flag := acceptedResult (close e (init 0u) 1u 0u 0u 0u 1u 2u 0u 0u 13952815165197967125756980119533420968413717059059621486339195579699957758172u 0u 0u 1u 2u 0u 0u 14701443190095777811686243040802400733041311233058721930520713618723616718186u 21888242871839275222246405745257275088548364400416034343698204186575808495617u)
def afterEntry : State -> Option (Prod State (List Out)) -> State := fun (s : State) (o : Option (Prod State (List Out))) => option s (fun (p : Prod State (List Out)) => first p) o
def oneDeposit : State := afterEntry (init 0u) (deposit e (init 0u) (first kp0) (second kp0) 10u)
def partialSeal : Flag := acceptedResult (seal e oneDeposit)
def mixedDeposit : Flag := acceptedResult (deposit e oneDeposit 7u 8u 100u)
def twoDeposits : State := afterEntry oneDeposit (deposit e oneDeposit (first kp1) (second kp1) 10u)
def threeDeposits : State := afterEntry twoDeposits (deposit e twoDeposits (first kp2) (second kp2) 10u)
def fullSeal : Flag := acceptedResult (seal e threeDeposits)
def fourthDeposit : Flag := acceptedResult (deposit e threeDeposits 11u 12u 10u)
def afterSeal : State := afterEntry threeDeposits (seal e threeDeposits)
def again1 : State := afterEntry afterSeal (deposit e afterSeal 5u 6u 10u)
def again2 : State := afterEntry again1 (deposit e again1 7u 8u 10u)
def again3 : State := afterEntry again2 (deposit e again2 9u 10u 10u)
def repeatedRoot : Flag := u256Eq (batchH threeDeposits) (batchH again3)

