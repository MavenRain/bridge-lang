-- A valid cast from cast.lang, with its signature and sum proof, is refused after opening.
def ballotWord : U256 := decisionWord (addW 100u 100u)
def ballotSig : List U256 := zkSign voters (zkKey 0) (pollWord 1u ballotWord)
  (ctWord (pair (pair v0s0c1x v0s0c1y) (pair v0s0c2x v0s0c2y)) (pair (pair v0s1c1x v0s1c1y) (pair v0s1c2x v0s1c2y)))
def sigAt : Nat -> U256 := fun (k : Nat) => second (fold
  (fun (w : U256) (r : Prod Nat U256) => pair (natAdd (first r) 1) (flagIf (natEq (first r) k) w (second r)))
  (pair 0 0u) ballotSig)
def ballotSlots : Map U256 U256 := mapSet (mapSet mapEmpty
  (hash (ctxOf (sigImage ballotSig) 1u) 0u) (hash (hash (hash v0s0c1x v0s0c1y) v0s0c2x) v0s0c2y))
  (hash (ctxOf (sigImage ballotSig) 1u) 1u) (hash (hash (hash v0s1c1x v0s1c1y) v0s1c2x) v0s1c2y)
def ballotState : Map U256 U256 -> State := fun (o : Map U256 U256) =>
  makeState 0u ballotSlots mapEmpty mapEmpty mapEmpty 0u o mapEmpty mapEmpty 1000u 1000u (batchSeed 0u) 0u 0 mapEmpty mapEmpty 0u 0u ringT0 ringT1 ringT2 ringT3

def ballot : State -> Flag := fun (s : State) => acceptedResult (cast e s 1u ballotWord
  v0s0c1x v0s0c1y v0s0c2x v0s0c2y v0s1c1x v0s1c1y v0s1c2x v0s1c2y
  v0sumax v0sumay v0sumbx v0sumby v0sumz (sigAt 5) (sigAt 4) (sigAt 3) (sigAt 2) (sigAt 1) (sigAt 0))
def castBeforeOpen : Flag := ballot (ballotState mapEmpty)
def castAfterOpen : Flag := ballot (ballotState (mapSet mapEmpty (hash 1u 0u) 1u))

