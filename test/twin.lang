def slotBallot : State -> Flag := fun (s : State) => acceptedResult (castSlot e s 1u 0u
  (first (sigImage ballotSig)) (second (sigImage ballotSig)) v0s0c1x v0s0c1y v0s0c2x v0s0c2y
  v0s0a0x v0s0a0y v0s0b0x v0s0b0y v0s0a1x v0s0a1y v0s0b1x v0s0b1y v0s0e0 v0s0e1 v0s0z0 v0s0z1)
