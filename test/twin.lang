def acceptedBatch : State := makeState 1u mapEmpty mapEmpty mapEmpty mapEmpty 0u mapEmpty mapEmpty mapEmpty
  1000u 1000u (batchSeed 0u) 0u 0 (mapSet mapEmpty (batchH threeDeposits) flagYes) mapEmpty 0u 0u ringT0 ringT1 ringT2 ringT3
-- A claim of 10u from batch n with the ring signature of key 0 over poll (hash claimTag n), at
-- eval time (Q-S10-18 (a)). claimBadSig: the words of that signature with the key image of key 1
-- (a point on BN254, thus the ring check refuses it). fold is a right fold: claimSigWord l k is
-- the word k from the end of l, thus c s1 s2 s3 ix iy = claimSigWord l 5, 4, 3, 2, 1, 0.
def claimSig : U256 -> List U256 := fun (n : U256) => zkSign voters (zkKey 0) (hash claimTag n) 10u
def claimSigWord : List U256 -> Nat -> U256 := fun (l : List U256) (k : Nat) => second (fold
  (fun (w : U256) (r : Prod Nat U256) => pair (natAdd (first r) 1) (flagIf (natEq (first r) k) w (second r)))
  (pair 0 0u) l)
def claimWith : U256 -> List U256 -> U256 -> U256 -> Flag := fun (n : U256) (g : List U256) (w4 w5 : U256) =>
  acceptedResult (claim e acceptedBatch n 10u 0u 1u 2u (claimSigWord g 5) (claimSigWord g 4) (claimSigWord g 3) (claimSigWord g 2) w4 w5)
def claimBatchZero : Flag := claimWith 0u (claimSig 0u) (claimSigWord (claimSig 0u) 1) (claimSigWord (claimSig 0u) 0)
def claimBatchOne : Flag := claimWith 1u (claimSig 1u) (claimSigWord (claimSig 1u) 1) (claimSigWord (claimSig 1u) 0)
def claimKeyOne : List U256 := zkSign voters (zkKey 1) (hash claimTag 0u) 10u
def claimBadSig : Flag := claimWith 0u (claimSig 0u) (claimSigWord claimKeyOne 1) (claimSigWord claimKeyOne 0)
