-- The twin contract (S10 s2, map D1, Q-S10-2 (a), Q-S10-3 (a)). One bytecode, two deployments:
-- side 0 (home) and side 1 (remote). The init argument is the side (Q-S10-5 (a)).
-- Home: castSlot k times, then cast; close one slot per call; enact on the stored Decision.
-- Remote: enact with the Schnorr attest. Both: deposit, seal, accept, claim.
-- A kit file is checked alone (O64). So the defs are copies of examples/cast.lang,
-- examples/elgamal.lang, examples/enact.lang and examples/bridge.lang. Each entry has 30 words at most.

def Point : Type 0 := Prod U256 U256
def Key : Type 0 := Prod U256 U256
def Cipher : Type 0 := Prod Point Point
def gen : Point := pair 1u 2u
def rMinusOne : U256 := 0x30644e72e131a029b85045b68181585d2833e84879b9709143e1f593f0000000u
-- -G = (r - 1) G = (1, p - 2).
def negG : Point := pair 1u 0x30644e72e131a029b85045b68181585d97816a916871ca8d3c208c16d87cfd45u
def maxWord : U256 := 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffu
def randTag : U256 := 0x72616e64u
def onehotTag : U256 := 0x6f6e65686f74u

-- Two points are equal when both coordinates are equal.
def ptEq : Point -> Point -> Flag := fun (a : Point) (b : Point) =>
  flagIf (u256Eq (first a) (first b)) (u256Eq (second a) (second b)) flagNo

-- The ring (examples/ballot.lang). The key image I is the last two words of a
-- signature. The fold visits the tail first.
def imgStep : U256 -> Prod U256 Key -> Prod U256 Key := fun (w : U256) (r : Prod U256 Key) =>
  flagIf (u256Eq (first r) 0u) (pair 1u (pair 0u w))
    (flagIf (u256Eq (first r) 1u) (pair 2u (pair w (second (second r)))) r)
def sigImage : List U256 -> Key := fun (s : List U256) => second (fold imgStep (pair 0u (pair 0u 0u)) s)
def spentHas : Key -> List Key -> Flag := fun (i : Key) (l : List Key) =>
  fold (fun (j : Key) (r : Flag) => flagIf (ptEq i j) flagYes r) flagNo l
def fresh : Key -> List Key -> Flag := fun (i : Key) (l : List Key) => flagIf (spentHas i l) flagNo flagYes
-- The voter ring is the curve keys of the test keys 0, 1 and 2.
def voters : List Key := cons (ecMul gen (zkKey 0)) (cons (ecMul gen (zkKey 1)) (cons (ecMul gen (zkKey 2)) nil))
def ballotPollOf : U256 -> U256 := fun (n : U256) => hash 0x62616c6c6f74u n

-- The ciphers (examples/elgamal.lang). The sum of two ciphers encrypts the sum
-- of the messages. The holder of x gets m G as C2 minus x C1.
def elgAdd : Cipher -> Cipher -> Cipher := fun (a : Cipher) (b : Cipher) =>
  pair (ecAdd (first a) (first b)) (ecAdd (second a) (second b))
def elgPoint : U256 -> Cipher -> Point := fun (x : U256) (c : Cipher) =>
  ecAdd (second c) (ecMul (ecMul (first c) x) rMinusOne)
def elgIs : U256 -> Cipher -> U256 -> Flag := fun (x : U256) (c : Cipher) (m : U256) =>
  ptEq (elgPoint x c) (ecMul gen m)

-- The Decision word (examples/enact.lang): keep, addLiq (dx, dy) or removeLiq (dx, dy).
def LiqW : Type 0 := Sum (Prod U256 U256) (Prod U256 U256)
def DecisionW : Type 0 := Sum Unit LiqW
def addW : U256 -> U256 -> DecisionW := fun (dx dy : U256) => inr (inl (pair dx dy))
def removeW : U256 -> U256 -> DecisionW := fun (dx dy : U256) => inr (inr (pair dx dy))
def decisionWord : DecisionW -> U256 := fun (d : DecisionW) =>
  either (fun (u : Unit) => hash (hash 0u 0u) 0u)
    (fun (l : LiqW) => either (fun (a : Prod U256 U256) => hash (hash 1u (first a)) (second a))
      (fun (a : Prod U256 U256) => hash (hash 2u (first a)) (second a)) l) d

-- The one-hot proofs (examples/onehot.lang). z P = A + e Q: 2 ecMul, 1 ecAdd.
def holds : (p a q : Prod U256 U256) -> (z e : U256) -> Flag :=
  fun (p a q : Prod U256 U256) (z e : U256) => ptEq (ecMul p z) (ecAdd a (ecMul q e))
def randChallenge : (ctx pkx pky c1x c1y c2x c2y m ax ay bx by : U256) -> U256 :=
  fun (ctx pkx pky c1x c1y c2x c2y m ax ay bx by : U256) =>
    hash (hash (hash (hash (hash (hash (hash (hash (hash (hash (hash (hash randTag ctx) pkx) pky) c1x) c1y) c2x) c2y) m) ax) ay) bx) by
def orChallenge : (ctx j pkx pky c1x c1y c2x c2y a0x a0y b0x b0y a1x a1y b1x b1y : U256) -> U256 :=
  fun (ctx j pkx pky c1x c1y c2x c2y a0x a0y b0x b0y a1x a1y b1x b1y : U256) =>
    hash (hash (hash (hash (hash (hash (hash (hash (hash (hash (hash (hash (hash (hash (hash (hash onehotTag ctx) j) pkx) pky) c1x) c1y) c2x) c2y) a0x) a0y) b0x) b0y) a1x) a1y) b1x) b1y
def randWith : (pkx pky c1x c1y c2x c2y m ax ay bx by z e : U256) -> Flag :=
  fun (pkx pky c1x c1y c2x c2y m ax ay bx by z e : U256) =>
    flagIf (holds gen (pair ax ay) (pair c1x c1y) z e)
      (holds (pair pkx pky) (pair bx by) (ecAdd (pair c2x c2y) (ecMul negG m)) z e)
      flagNo
def rand : (ctx pkx pky c1x c1y c2x c2y m ax ay bx by z : U256) -> Flag :=
  fun (ctx pkx pky c1x c1y c2x c2y m ax ay bx by z : U256) =>
    randWith pkx pky c1x c1y c2x c2y m ax ay bx by z (randChallenge ctx pkx pky c1x c1y c2x c2y m ax ay bx by)
-- e0 + e1 = e modulo 2^256 with no add (u256Add traps on an overflow).
def splitOk : (e e0 e1 : U256) -> Flag :=
  fun (e e0 e1 : U256) =>
    flagIf (u256Le e0 e) (u256Eq (u256Sub e e0) e1)
      (flagIf (u256Le 1u e1) (u256Eq (u256Sub e1 1u) (u256Sub maxWord (u256Sub e0 e))) flagNo)
def slotWith : (pkx pky c1x c1y c2x c2y a0x a0y b0x b0y a1x a1y b1x b1y e0 e1 z0 z1 e : U256) -> Flag :=
  fun (pkx pky c1x c1y c2x c2y a0x a0y b0x b0y a1x a1y b1x b1y e0 e1 z0 z1 e : U256) =>
    flagIf (splitOk e e0 e1)
      (flagIf (holds gen (pair a0x a0y) (pair c1x c1y) z0 e0)
        (flagIf (holds (pair pkx pky) (pair b0x b0y) (pair c2x c2y) z0 e0)
          (flagIf (holds gen (pair a1x a1y) (pair c1x c1y) z1 e1)
            (holds (pair pkx pky) (pair b1x b1y) (ecAdd (pair c2x c2y) negG) z1 e1)
            flagNo)
          flagNo)
        flagNo)
      flagNo
def slot : (ctx j pkx pky c1x c1y c2x c2y a0x a0y b0x b0y a1x a1y b1x b1y e0 e1 z0 z1 : U256) -> Flag :=
  fun (ctx j pkx pky c1x c1y c2x c2y a0x a0y b0x b0y a1x a1y b1x b1y e0 e1 z0 z1 : U256) =>
    slotWith pkx pky c1x c1y c2x c2y a0x a0y b0x b0y a1x a1y b1x b1y e0 e1 z0 z1
      (orChallenge ctx j pkx pky c1x c1y c2x c2y a0x a0y b0x b0y a1x a1y b1x b1y)

-- A slot proof is (A0, B0), (A1, B1), (e0, e1) and (z0, z1). A sum proof is
-- (A, B) and z. The committee key is 7 (examples/elgamal.lang, Q-S10-4 (a)).
def SlotPf : Type 0 := Prod (Prod Point Point) (Prod (Prod Point Point) (Prod (Prod U256 U256) (Prod U256 U256)))
def SumPf : Type 0 := Prod (Prod Point Point) U256
def pk : Point := ecMul gen 7u
def slotPf : U256 -> U256 -> Cipher -> SlotPf -> Flag := fun (ctx j : U256) (c : Cipher) (q : SlotPf) =>
  slot ctx j (first pk) (second pk) (first (first c)) (second (first c)) (first (second c)) (second (second c))
    (first (first (first q))) (second (first (first q))) (first (second (first q))) (second (second (first q)))
    (first (first (first (second q)))) (second (first (first (second q))))
    (first (second (first (second q)))) (second (second (first (second q))))
    (first (first (second (second q)))) (second (first (second (second q))))
    (first (second (second (second q)))) (second (second (second (second q))))
def sumPf : U256 -> Cipher -> SumPf -> Flag := fun (ctx : U256) (c : Cipher) (q : SumPf) =>
  rand ctx (first pk) (second pk) (first (first c)) (second (first c)) (first (second c)) (second (second c)) 1u
    (first (first (first q))) (second (first (first q))) (first (second (first q))) (second (second (first q)))
    (second q)

-- w is the hash chain of the 8 ciphertext coordinates, slot 0 first.
def ctWord : Cipher -> Cipher -> U256 := fun (c0 c1 : Cipher) =>
  hash (hash (hash (hash (hash (hash (hash (first (first c0)) (second (first c0))) (first (second c0))) (second (second c0)))
    (first (first c1))) (second (first c1))) (first (second c1))) (second (second c1))
def ctxOf : Key -> U256 -> U256 := fun (i : Key) (n : U256) => hash (hash (first i) (second i)) n
def pollWord : U256 -> U256 -> U256 := fun (n p : U256) => hash (ballotPollOf n) p

-- A CastBox is one poll: the poll n, the tally of each slot and the spent list.
def CastBox : Type 0 := Prod U256 (Prod (Prod Cipher Cipher) (List Key))
def castPoll : CastBox -> U256 := fun (box : CastBox) => first box
def castTally : CastBox -> Prod Cipher Cipher := fun (box : CastBox) => first (second box)
def castSpent : CastBox -> List Key := fun (box : CastBox) => second (second box)
-- The tally starts at (O, O) in each slot: ecAdd takes (0, 0) as O.
def zeroC : Cipher := pair (pair 0u 0u) (pair 0u 0u)
def emptyCast : U256 -> CastBox := fun (n : U256) => pair n (pair (pair zeroC zeroC) nil)

-- One cast: the ring signature over w at the poll word, a fresh key image,
-- the two slot proofs and the sum proof, all at the bound ctx.
def castOk : CastBox -> U256 -> Cipher -> Cipher -> SlotPf -> SlotPf -> SumPf -> List U256 -> Flag :=
  fun (box : CastBox) (p : U256) (c0 c1 : Cipher) (q0 q1 : SlotPf) (qs : SumPf) (s : List U256) =>
    flagIf (zkVerify voters (pollWord (castPoll box) p) (ctWord c0 c1) s)
      (flagIf (fresh (sigImage s) (castSpent box))
        (flagIf (slotPf (ctxOf (sigImage s) (castPoll box)) 0u c0 q0)
          (flagIf (slotPf (ctxOf (sigImage s) (castPoll box)) 1u c1 q1)
            (sumPf (ctxOf (sigImage s) (castPoll box)) (elgAdd c0 c1) qs)
            flagNo)
          flagNo)
        flagNo)
      flagNo
-- The box after a cast: each slot is added to its tally, and the key image goes to the spent list.
def castNext : CastBox -> Cipher -> Cipher -> List U256 -> CastBox :=
  fun (box : CastBox) (c0 c1 : Cipher) (s : List U256) =>
    pair (castPoll box)
      (pair (pair (elgAdd (first (castTally box)) c0) (elgAdd (second (castTally box)) c1))
        (cons (sigImage s) (castSpent box)))
-- The word form: a cast that fails keeps the box.
def castW : CastBox -> U256 -> Cipher -> Cipher -> SlotPf -> SlotPf -> SumPf -> List U256 -> CastBox :=
  fun (box : CastBox) (p : U256) (c0 c1 : Cipher) (q0 q1 : SlotPf) (qs : SumPf) (s : List U256) =>
    flagIf (castOk box p c0 c1 q0 q1 qs s) (castNext box c0 c1 s) box
-- The typed form: the cast needs a proof that castOk holds.
def CastSig : CastBox -> U256 -> Cipher -> Cipher -> SlotPf -> SlotPf -> SumPf -> List U256 -> Type 0 :=
  fun (box : CastBox) (p : U256) (c0 c1 : Cipher) (q0 q1 : SlotPf) (qs : SumPf) (s : List U256) =>
    Path Flag (castOk box p c0 c1 q0 q1 qs s) flagYes
def castTyped : (box : CastBox) -> (p : U256) -> (c0 c1 : Cipher) -> (q0 q1 : SlotPf) -> (qs : SumPf) -> (s : List U256) -> CastSig box p c0 c1 q0 q1 qs s -> CastBox :=
  fun (box : CastBox) (p : U256) (c0 c1 : Cipher) (q0 q1 : SlotPf) (qs : SumPf) (s : List U256) (h : CastSig box p c0 c1 q0 q1 qs s) =>
    castNext box c0 c1 s

-- The threshold open, the DLEQ proof and the attest (copies of examples/elgamal.lang, g is gen).

def lag12 : Point -> Point -> Point := fun (d1 : Point) (d2 : Point) =>
  ecAdd (ecMul d1 2u) (ecMul d2 rMinusOne)
def openPoint : Point -> Point -> Cipher -> Point := fun (d1 : Point) (d2 : Point) (c : Cipher) =>
  ecAdd (second c) (ecMul (lag12 d1 d2) rMinusOne)
def openIs : Point -> Point -> Cipher -> U256 -> Flag := fun (d1 : Point) (d2 : Point) (c : Cipher) (m : U256) =>
  ptEq (openPoint d1 d2 c) (ecMul gen m)
def hashPt : Point -> U256 := fun (q : Point) => hash (first q) (second q)
def dleqC : Point -> Point -> Point -> Point -> Point -> U256 := fun (a : Point) (b : Point) (x : Point) (c1 : Point) (d : Point) =>
  hash (hash (hashPt a) (hashPt b)) (hash (hashPt x) (hash (hashPt c1) (hashPt d)))
def dleqOk : Point -> Point -> Point -> Prod (Prod Point Point) U256 -> Flag :=
  fun (x : Point) (c1 : Point) (d : Point) (p : Prod (Prod Point Point) U256) =>
    flagIf (ptEq (ecMul gen (second p)) (ecAdd (first (first p)) (ecMul x (dleqC (first (first p)) (second (first p)) x c1 d))))
      (ptEq (ecMul c1 (second p)) (ecAdd (second (first p)) (ecMul d (dleqC (first (first p)) (second (first p)) x c1 d))))
      flagNo
-- The attest tags (Q-S10-13 (a)): ASCII enact and ASCII accept. The tag is the first word of the
-- message, so a message of one use is not a message of the other use (a match needs a keccak collision).
def enactTag : U256 := 0x656e616374u
def acceptTag : U256 := 0x616363657074u
def attestMsg : U256 -> U256 -> U256 -> U256 -> U256 := fun (dom : U256) (side : U256) (n : U256) (d : U256) => hash (hash (hash dom side) n) d
def schnorrOk : Point -> U256 -> Prod Point U256 -> Flag := fun (y : Point) (msg : U256) (sig : Prod Point U256) =>
  ptEq (ecMul gen (second sig)) (ecAdd (first sig) (ecMul y (hash (hash (hashPt (first sig)) (hashPt y)) msg)))

-- The pool checks and prices (copies of examples/enact.lang).

-- mul, divFloor and divCeil on the kit primitives u256Mul and u256Div (Q-S10-9 (a)). The fold defs of
-- examples/enact.lang do not lower. u256Mul traps on an overflow and u256Div traps on 0, as the fold defs do.
def mul : U256 -> U256 -> U256 := fun (a b : U256) => u256Mul a b
def divFloor : U256 -> U256 -> U256 := fun (n d : U256) => u256Div n d
def divCeil : U256 -> U256 -> U256 := fun (n d : U256) =>
  u256Add (divFloor n d) (flagIf (u256Eq (mul (divFloor n d) d) n) 0u 1u)

def wMax : U256 := 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffu
def bound : U256 := 0xffffffffffffffffffffffffffffffffu
def outIn : (x y dx : U256) -> U256 := fun (x y dx : U256) => divFloor (mul y dx) (u256Add x dx)
def inOut : (x y c : U256) -> U256 := fun (x y c : U256) => divCeil (mul x c) (u256Sub y c)
def addOk : U256 -> U256 -> U256 -> U256 -> Flag := fun (x y dx dy : U256) =>
  flagIf (u256Le 1u dx) (flagIf (u256Le 1u dy)
    (flagIf (u256Le (mul dx y) (mul dy x))
      (u256Le (u256Add (mul dy x) 1u) (u256Add (mul dx y) x)) flagNo) flagNo) flagNo
def removeOk : U256 -> U256 -> U256 -> U256 -> Flag := fun (x y dx dy : U256) =>
  flagIf (u256Le (u256Add dx 1u) x)
    (flagIf (u256Le (mul dy x) (mul dx y))
      (u256Le (u256Add (mul dx y) 1u) (u256Add (mul dy x) x)) flagNo) flagNo

-- The pool words per coordinate (the words of addLiqW, removeLiqW, swapOutW and claimW in examples/enact.lang
-- and examples/bridge.lang). K4c does not lower first at a word position. Thus each coordinate is a word def.
-- resTrap x y is 0. It traps when x or y is not in 1..bound (the check of checkedReserves). Each coordinate
-- checks the two words, so a projection cannot skip the check in the lazy evaluator.
def resTrap : U256 -> U256 -> U256 := fun (x y : U256) =>
  u256Sub (u256Add wMax (flagIf (u256Le 1u x) (flagIf (u256Le x bound) (flagIf (u256Le 1u y) (flagIf (u256Le y bound) 0u 1u) 1u) 1u) 1u)) wMax
def checkedX : U256 -> U256 -> U256 := fun (x y : U256) => u256Add (resTrap x y) x
def checkedY : U256 -> U256 -> U256 := fun (x y : U256) => u256Add (resTrap x y) y
def addLiqX : (x y dx dy : U256) -> U256 := fun (x y dx dy : U256) => checkedX (u256Add x dx) (u256Add y dy)
def addLiqY : (x y dx dy : U256) -> U256 := fun (x y dx dy : U256) => checkedY (u256Add x dx) (u256Add y dy)
def removeLiqX : (x y dx dy : U256) -> U256 := fun (x y dx dy : U256) => checkedX (u256Sub x dx) (u256Sub y dy)
def removeLiqY : (x y dx dy : U256) -> U256 := fun (x y dx dy : U256) => checkedY (u256Sub x dx) (u256Sub y dy)
def swapOutX : (x y c : U256) -> U256 := fun (x y c : U256) => checkedX (u256Add x (inOut x y c)) (u256Sub y c)
def swapOutY : (x y c : U256) -> U256 := fun (x y c : U256) => checkedY (u256Add x (inOut x y c)) (u256Sub y c)
def claimX : (x y c : U256) -> U256 := fun (x y c : U256) => checkedX (u256Sub x (outIn y x c)) (u256Add y c)
def claimY : (x y c : U256) -> U256 := fun (x y c : U256) => checkedY (u256Sub x (outIn y x c)) (u256Add y c)

def asset : Addr := 0x00000000000000000000000000000000000000ee
def vault : Addr := 0x00000000000000000000000000000000000000cc
def batchSeed : U256 -> U256 := fun (n : U256) => hash 0x6261746368u n

event Sealed (from : U256) (n : U256) (h : U256)
event Claimed (image : U256) (d : U256)

-- The storage (map D1). The side is the init argument (Q-S10-5 (a)). The reserves start at (1000, 1000).
state State := makeState (side : U256) (slots : Map U256 U256) (tally : Map U256 U256) (used : Map U256 Flag) (props : Map U256 U256) (casts : U256) (opened : Map U256 U256) (decided : Map U256 U256) (enacted : Map U256 Flag) (rx : U256) (ry : U256) (batchH : U256) (batchN : U256) (sealAt : Nat) (accepted : Map U256 Flag) (claimed : Map U256 Flag) (batchSize : U256) (batchCredit : U256) (ring0 : Map U256 U256) (ring1 : Map U256 U256) (ring2 : Map U256 U256) (ring3 : Map U256 U256)

-- Entry (home): one slot OR proof at ctx. It stores the hash of the slot cipher under (ctx, j).
def castSlot : (env : Env) -> (s : State) -> (n j ix iy c1x c1y c2x c2y a0x a0y b0x b0y a1x a1y b1x b1y e0 e1 z0 z1 : U256) -> Option (Prod State (List Out)) :=
  fun (env : Env) (s : State) (n j ix iy c1x c1y c2x c2y a0x a0y b0x b0y a1x a1y b1x b1y e0 e1 z0 z1 : U256) =>
    flagIf (flagIf (u256Eq (side s) 0u) (u256Eq (mapGet (opened s) (hash n 0u)) 0u) flagNo)
      (flagIf (u256Le j 1u)
      (flagIf (slot (ctxOf (pair ix iy) n) j (first pk) (second pk) c1x c1y c2x c2y a0x a0y b0x b0y a1x a1y b1x b1y e0 e1 z0 z1)
      (some (pair (makeState (side s) (mapSet (slots s) (hash (ctxOf (pair ix iy) n) j) (hash (hash (hash c1x c1y) c2x) c2y)) (tally s) (used s) (props s) (casts s) (opened s) (decided s) (enacted s) (rx s) (ry s) (batchH s) (batchN s) (sealAt s) (accepted s) (claimed s) (batchSize s) (batchCredit s) (ring0 s) (ring1 s) (ring2 s) (ring3 s)) nil))
      none)
      none)
      none

-- The shared bLSAG routine (Q-S10-15 (a), S10 s4). The cast entry and the claim entry call sharedRing.
-- The ring is the closed key table of (P, H_p(P)) pairs, in the order of voters (Q-S10-17 (b)).
def blsagTag : U256 := 0x6f72626974u
def claimTag : U256 := 0x636c61696du
def chal : (d poll ch ix iy : U256) -> (l r : Point) -> U256 := fun (d poll ch ix iy : U256) (l r : Point) =>
  hash (hash (hash (hash (hash (hash (hash (hash (hash blsagTag d) poll) ch) ix) iy) (first l)) (second l)) (first r)) (second r)
def link : (d poll ch ix iy c s : U256) -> (p h : Point) -> U256 := fun (d poll ch ix iy c s : U256) (p h : Point) =>
  chal d poll ch ix iy (ecAdd (ecMul gen s) (ecMul p c)) (ecAdd (ecMul h s) (ecMul (pair ix iy) c))
def digest3 : (p0 p1 p2 : Point) -> U256 := fun (p0 p1 p2 : Point) =>
  hash (hash (hash (hash (hash (first p0) (second p0)) (first p1)) (second p1)) (first p2)) (second p2)
def blsag3 : (p0 h0 p1 h1 p2 h2 : Point) -> (poll ch c s1 s2 s3 ix iy : U256) -> Flag :=
  fun (p0 h0 p1 h1 p2 h2 : Point) (poll ch c s1 s2 s3 ix iy : U256) =>
  flagIf (u256Eq (link (digest3 p0 p1 p2) poll ch ix iy (link (digest3 p0 p1 p2) poll ch ix iy (link (digest3 p0 p1 p2) poll ch ix iy c s1 p0 h0) s2 p1 h1) s3 p2 h2) c)
    (flagIf (u256Le s1 rMinusOne) (flagIf (u256Le s2 rMinusOne) (flagIf (u256Le s3 rMinusOne)
      (flagIf (u256Eq ix 0u) (flagIf (u256Eq iy 0u) flagNo flagYes) flagYes) flagNo) flagNo) flagNo)
    flagNo
def kp0 : Key := ecMul gen (zkKey 0)
def kp1 : Key := ecMul gen (zkKey 1)
def kp2 : Key := ecMul gen (zkKey 2)
def kh0 : Key := zkHp kp0
def kh1 : Key := zkHp kp1
def kh2 : Key := zkHp kp2
-- The ring tables (Q-S10-17 (b2), Q-S10-18 (a)): key i of the ring at i in ringT0 (P.x) and
-- ringT1 (P.y), its H_p at i in ringT2 (H.x) and ringT3 (H.y). init stores them in the state
-- fields ring0 to ring3.
def ringT0 : Map U256 U256 :=
  mapSet (mapSet (mapSet mapEmpty 0u (first kp0)) 1u (first kp1)) 2u (first kp2)
def ringT1 : Map U256 U256 :=
  mapSet (mapSet (mapSet mapEmpty 0u (second kp0)) 1u (second kp1)) 2u (second kp2)
def ringT2 : Map U256 U256 :=
  mapSet (mapSet (mapSet mapEmpty 0u (first kh0)) 1u (first kh1)) 2u (first kh2)
def ringT3 : Map U256 U256 :=
