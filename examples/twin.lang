-- Entry: claim the credit d from accepted batch n of 3 deposits of d. The key image is fresh per
-- batch number: claimed is keyed by (I, n) (Q-S10-18 (a)). The ring signature over the batch keys
-- is on the EVM (Q-S10-15 (a), Q-S10-17 (b)): sharedRing reads the 3 keys at the indices i0 i1 i2
-- from the ring tables that init stores. An index over 2 is refused.
def claim : (env : Env) -> (s : State) -> (n d i0 i1 i2 c s1 s2 s3 w4 w5 : U256) -> Option (Prod State (List Out)) :=
  fun (env : Env) (s : State) (n d i0 i1 i2 c s1 s2 s3 w4 w5 : U256) =>
    flagIf (flagIf (u256Le i0 2u) (flagIf (u256Le i1 2u) (u256Le i2 2u) flagNo) flagNo)
      (flagIf (mapGet (accepted s) (hash (hash (hash (hash (hash (hash (hash (hash (hash (batchSeed n) (mapGet (ring0 s) i0)) (mapGet (ring1 s) i0)) d) (mapGet (ring0 s) i1)) (mapGet (ring1 s) i1)) d) (mapGet (ring0 s) i2)) (mapGet (ring1 s) i2)) d))
      (flagIf (flagIf (mapGet (claimed s) (hash (hash w4 w5) n)) flagNo flagYes)
      (flagIf (sharedRing env s i0 i1 i2 (hash claimTag n) d c s1 s2 s3 w4 w5)
      (some (pair (makeState (side s) (slots s) (tally s) (used s) (props s) (casts s) (opened s) (decided s) (enacted s) (claimX (rx s) (ry s) d) (claimY (rx s) (ry s) d) (batchH s) (batchN s) (sealAt s) (accepted s) (mapSet (claimed s) (hash (hash w4 w5) n) flagYes) (batchSize s) (batchCredit s) (ring0 s) (ring1 s) (ring2 s) (ring3 s)) (cons (pay asset (caller env) (outIn (ry s) (rx s) d)) (cons (Claimed (hash w4 w5) d) nil))))
      none)
      none)
      none)
      none

-- Views.
def sideOf : (env : Env) -> (s : State) -> U256 := fun (env : Env) (s : State) => side s
def rxOf : (env : Env) -> (s : State) -> U256 := fun (env : Env) (s : State) => rx s
def ryOf : (env : Env) -> (s : State) -> U256 := fun (env : Env) (s : State) => ry s
def decidedOf : (env : Env) -> (s : State) -> (n : U256) -> U256 := fun (env : Env) (s : State) (n : U256) => mapGet (decided s) n
def openedOf : (env : Env) -> (s : State) -> (n j : U256) -> U256 := fun (env : Env) (s : State) (n j : U256) => mapGet (opened s) (hash n j)
