  fun (env : Env) (s : State) (n h sx sy ss : U256) =>
    flagIf (flagIf (mapGet (accepted s) h) flagNo flagYes)
      (flagIf (schnorrOk pk (attestMsg acceptTag (u256Sub 1u (side s)) n h) (pair (pair sx sy) ss))
      (some (pair (makeState (side s) (slots s) (tally s) (used s) (props s) (casts s) (opened s) (decided s) (enacted s) (rx s) (ry s) (batchH s) (batchN s) (sealAt s) (mapSet (accepted s) h flagYes) (claimed s) (batchSize s) (batchCredit s) (ring0 s) (ring1 s) (ring2 s) (ring3 s)) nil))
      none)
