      (some (pair (makeState (side s) (slots s) (tally s) (used s) (props s) (casts s) (mapSet (opened s) (hash n j) (u256Add m 1u)) (mapSet (decided s) n (flagIf (u256Eq j 1u) (flagIf (u256Le 3u (mapGet (opened s) (hash n 0u))) (mapGet (props s) n) (hash (hash 0u 0u) 0u)) (mapGet (decided s) n))) (enacted s) (rx s) (ry s) (batchH s) (batchN s) (sealAt s) (accepted s) (claimed s) (batchSize s) (batchCredit s) (ring0 s) (ring1 s) (ring2 s) (ring3 s)) nil))
