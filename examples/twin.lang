  fun (env : Env) (s : State) (kx ky c : U256) =>
    flagIf (flagIf (u256Le (batchSize s) 2u) (flagIf (u256Eq (batchSize s) 0u) (flagIf (u256Eq c 10u) flagYes (u256Eq c 100u)) (u256Eq c (batchCredit s))) flagNo)
      (flagIf (u256Le (u256Add c 1u) (ry s))
      (some (pair (makeState (side s) (slots s) (tally s) (used s) (props s) (casts s) (opened s) (decided s) (enacted s) (swapOutX (rx s) (ry s) c) (swapOutY (rx s) (ry s) c) (hash (hash (hash (batchH s) kx) ky) c) (batchN s) (sealAt s) (accepted s) (claimed s) (u256Add (batchSize s) 1u) c (ring0 s) (ring1 s) (ring2 s) (ring3 s)) (cons (pull asset (caller env) vault (inOut (rx s) (ry s) c)) nil)))
      none)
      none

-- Entry: seal a full batch when now is at the stored bound or later (Q-S10-6 (a)).
