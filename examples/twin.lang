  fun (env : Env) (s : State) =>
    flagIf (flagIf (u256Eq (batchSize s) 3u) (natLe (sealAt s) (now env)) flagNo)
      (some (pair (makeState (side s) (slots s) (tally s) (used s) (props s) (casts s) (opened s) (decided s) (enacted s) (rx s) (ry s) (batchSeed (u256Add (batchN s) 1u)) (u256Add (batchN s) 1u) (natAdd (now env) 60) (accepted s) (claimed s) 0u 0u (ring0 s) (ring1 s) (ring2 s) (ring3 s)) (cons (Sealed (side s) (batchN s) (batchH s)) nil)))
      none

-- Entry: accept the batch hash h of batch n of the other side with the Schnorr attest (key 7).
