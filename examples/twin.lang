      (flagIf (dleqOk (ecMul gen 12u) (pair (mapGet (tally s) (hash n (u256Add (u256Add (u256Add j j) (u256Add j j)) 0u))) (mapGet (tally s) (hash n (u256Add (u256Add (u256Add j j) (u256Add j j)) 1u)))) (pair e1x e1y) (pair (pair (pair a1x a1y) (pair b1x b1y)) z1))
      (flagIf (dleqOk (ecMul gen 17u) (pair (mapGet (tally s) (hash n (u256Add (u256Add (u256Add j j) (u256Add j j)) 0u))) (mapGet (tally s) (hash n (u256Add (u256Add (u256Add j j) (u256Add j j)) 1u)))) (pair e2x e2y) (pair (pair (pair a2x a2y) (pair b2x b2y)) z2))
