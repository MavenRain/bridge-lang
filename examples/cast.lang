def cipherOf : U256 -> U256 -> U256 -> U256 -> Cipher := fun (c1x c1y c2x c2y : U256) =>
  pair (pair c1x c1y) (pair c2x c2y)
def slotPfOf : (a0x a0y b0x b0y a1x a1y b1x b1y e0 e1 z0 z1 : U256) -> SlotPf :=
  fun (a0x a0y b0x b0y a1x a1y b1x b1y e0 e1 z0 z1 : U256) =>
    pair (pair (pair a0x a0y) (pair b0x b0y)) (pair (pair (pair a1x a1y) (pair b1x b1y)) (pair (pair e0 e1) (pair z0 z1)))
def sumPfOf : U256 -> U256 -> U256 -> U256 -> U256 -> SumPf := fun (ax ay bx by z : U256) =>
  pair (pair (pair ax ay) (pair bx by)) z
