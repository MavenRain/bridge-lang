-- The poll proposes addLiq (100, 100) (enact.lang addD). removeLiq is another proposal.
def pAdd : U256 := decisionWord (addW 100u 100u)
def pRemove : U256 := decisionWord (removeW 100u 100u)
def sv0 : List U256 := zkSign voters (zkKey 0) (pollWord 1u pAdd) (ctWord v0c0 v0c1)
def sv1 : List U256 := zkSign voters (zkKey 1) (pollWord 1u pAdd) (ctWord v1c0 v1c1)
def sv2 : List U256 := zkSign voters (zkKey 2) (pollWord 1u pAdd) (ctWord v2c0 v2c1)
def box0 : CastBox := emptyCast 1u
def box1 : CastBox := castW box0 pAdd v0c0 v0c1 v0q0 v0q1 v0qs sv0
def box2 : CastBox := castW box1 pAdd v1c0 v1c1 v1q0 v1q1 v1qs sv1
def box3 : CastBox := castW box2 pAdd v2c0 v2c1 v2q0 v2q1 v2qs sv2
def lawCast : Path Flag (castOk box0 pAdd v0c0 v0c1 v0q0 v0q1 v0qs sv0) flagYes := refl
def typed1 : CastBox := castTyped box0 pAdd v0c0 v0c1 v0q0 v0q1 v0qs sv0 refl

-- The eval rows.
def castFirst : Flag := castOk box0 pAdd v0c0 v0c1 v0q0 v0q1 v0qs sv0
def castSecond : Flag := castOk box1 pAdd v1c0 v1c1 v1q0 v1q1 v1qs sv1
def castThird : Flag := castOk box2 pAdd v2c0 v2c1 v2q0 v2q1 v2qs sv2
-- The voter 0 again: the key image is in the spent list of box1.
def castDup : Flag := castOk box1 pAdd v0c0 v0c1 v0q0 v0q1 v0qs sv0
-- A poll 1 ballot into a poll 2 box, and a ballot for addLiq into a removeLiq poll.
def castOtherPoll : Flag := castOk (emptyCast 2u) pAdd v0c0 v0c1 v0q0 v0q1 v0qs sv0
def castOtherProp : Flag := castOk box0 pRemove v0c0 v0c1 v0q0 v0q1 v0qs sv0
-- Slot 0 encrypts 2 with a forged split. The ring signature is good.
def castForged : Flag := castOk box0 pAdd fc v0c1 fq v0q1 v0qs
  (zkSign voters (zkKey 0) (pollWord 1u pAdd) (ctWord fc v0c1))
-- The voter 1 ballot under the ring signature of the voter 2: ctx has the voter 2 image (intent-lang O34).
def castCopy : Flag := castOk box0 pAdd v1c0 v1c1 v1q0 v1q1 v1qs
  (zkSign voters (zkKey 2) (pollWord 1u pAdd) (ctWord v1c0 v1c1))
-- The voter 2 ciphertexts with the voter 0 proofs.
def castOtherCt : Flag := castOk box0 pAdd v2c0 v2c1 v0q0 v0q1 v0qs
  (zkSign voters (zkKey 0) (pollWord 1u pAdd) (ctWord v2c0 v2c1))
-- Two ballots that differ only at slot 1 C2 have different words.
def wSlot1C2 : Flag := u256Eq (ctWord v0c0 v0c1) (ctWord v0c0 (pair (first v0c1) (second v1c1)))
-- The choices are 0, 1 and 0: slot 0 opens to 2 and slot 1 opens to 1 with the key 7.
def tallied0 : Flag := elgIs 7u (first (castTally box3)) 2u
def tallied1 : Flag := elgIs 7u (second (castTally box3)) 1u
