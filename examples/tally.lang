-- Encrypted ballots and the tally (S9, PLAN 3.1). A ballot is an
-- encrypted vote vector with a proof that it is one-hot. tallyEnc adds the
-- 3 members by encOp2, so it never opens a ciphertext. tally3 and tallyLaw
-- name decrypt only at the ends of a Path, so they are laws (rule O7, O59).
-- decide is the constitution of a liquidity Decision: it takes plain Votes.
-- close opens the tally, so it is in the kit example tally-ideal.lang.
def sizeAdd : Size -> Size -> Size :=
  fun (n : Size) (m : Size) => fold m (fun (r : Size) => szS r) n
def Member : Type 0 := Sum Unit (Sum Unit Unit)
def Choice : Type 0 := Sum Unit Unit
def m0 : Member := inl unit
def m1 : Member := inr (inl unit)
def m2 : Member := inr (inr unit)
def Votes : Type 0 := Prod Size Size
def vadd : Votes -> Votes -> Votes := fun (u : Votes) (v : Votes) =>
  pair (sizeAdd (first u) (first v)) (sizeAdd (second u) (second v))
def oneHot : Choice -> Votes := fun (c : Choice) =>
  either (fun (u : Unit) => pair (szS sz0) sz0) (fun (u : Unit) => pair sz0 (szS sz0)) c
-- The proof is bound to this ciphertext and hidden under Trunc1. A bare
-- Enc Votes could give one member several votes or votes for both choices.
def OneHot : Enc Votes -> Type 0 := fun (c : Enc Votes) =>
  Trunc1 ((v : Choice) * Path Votes (decrypt Votes c) (oneHot v))
def Ballot : Type 0 := (c : Enc Votes) * OneHot c
def castEnc : Choice -> Ballot := fun (c : Choice) =>
  pack (encEta Votes (oneHot c))
    (trunc1 ((v : Choice) * Path Votes (oneHot c) (oneHot v))
      (pack c refl))
def ballotsAt : Choice -> Choice -> Choice -> Member -> Ballot :=
  fun (c0 c1 c2 : Choice) (m : Member) =>
  either (fun (u : Unit) => castEnc c0)
    (fun (r : Sum Unit Unit) => either (fun (u : Unit) => castEnc c1) (fun (u : Unit) => castEnc c2) r) m
def tallyEnc : (Member -> Ballot) -> Enc Votes := fun (bs : Member -> Ballot) =>
  encOp2 Votes Votes Votes vadd (encOp2 Votes Votes Votes vadd (witness (bs m0)) (witness (bs m1))) (witness (bs m2))
def count : (Member -> Votes) -> Votes := fun (vs : Member -> Votes) =>
  vadd (vadd (vs m0) (vs m1)) (vs m2)
def tally3 : (c0 : Enc Votes) -> (c1 : Enc Votes) -> (c2 : Enc Votes) ->
    Path Votes (decrypt Votes (encOp2 Votes Votes Votes vadd (encOp2 Votes Votes Votes vadd c0 c1) c2))
      (vadd (vadd (decrypt Votes c0) (decrypt Votes c1)) (decrypt Votes c2)) :=
  fun (c0 : Enc Votes) (c1 : Enc Votes) (c2 : Enc Votes) =>
  elim (fun (d0 : Enc Votes) => Path Votes (decrypt Votes (encOp2 Votes Votes Votes vadd (encOp2 Votes Votes Votes vadd d0 c1) c2))
      (vadd (vadd (decrypt Votes d0) (decrypt Votes c1)) (decrypt Votes c2)))
    (fun (a : Votes) => elim (fun (d1 : Enc Votes) => Path Votes (decrypt Votes (encOp2 Votes Votes Votes vadd (encOp2 Votes Votes Votes vadd (encEta Votes a) d1) c2))
        (vadd (vadd a (decrypt Votes d1)) (decrypt Votes c2)))
      (fun (b : Votes) => elim (fun (d2 : Enc Votes) => Path Votes (decrypt Votes (encOp2 Votes Votes Votes vadd (encOp2 Votes Votes Votes vadd (encEta Votes a) (encEta Votes b)) d2))
          (vadd (vadd a b) (decrypt Votes d2)))
        (fun (e : Votes) => refl) c2) c1) c0
def tallyLaw : (bs : Member -> Ballot) ->
    Path Votes (decrypt Votes (tallyEnc bs)) (count (fun (m : Member) => decrypt Votes (witness (bs m)))) :=
  fun (bs : Member -> Ballot) => tally3 (witness (bs m0)) (witness (bs m1)) (witness (bs m2))
-- Liquidity Decisions (PLAN 4.3, Q4). Liq is an addLiq or a removeLiq
-- amount pair (the guest Size surrogate of the kit U256 pair); keep is inl.
-- level counts to 2, and a proposal passes at 2 of 3 votes for it.
def Liq : Type 0 := Sum Votes Votes
def Decision : Type 0 := Sum Unit Liq
def Level : Type 0 := Sum Unit (Sum Unit Unit)
def lzero : Level := inl unit
def up : Level -> Level := fun (l : Level) =>
  either (fun (u : Unit) => inr (inl unit)) (fun (r : Sum Unit Unit) => inr (inr unit)) l
def level : Size -> Level := fun (n : Size) => fold lzero up n
def atLeast2 : Size -> Choice := fun (n : Size) =>
  either (fun (u : Unit) => inr unit) (fun (r : Sum Unit Unit) => either (fun (u : Unit) => inr unit) (fun (u : Unit) => inl unit) r) (level n)
def decide : Liq -> Votes -> Decision := fun (p : Liq) (v : Votes) =>
  either (fun (u : Unit) => inr p) (fun (u : Unit) => inl unit) (atLeast2 (first v))
-- The close law: the Decision of the opened tally is the Decision of the
-- count of the opened ballots (cong of decide on tallyLaw).
def closeLaw : (p : Liq) -> (bs : Member -> Ballot) ->
    Path Decision (decide p (decrypt Votes (tallyEnc bs))) (decide p (count (fun (m : Member) => decrypt Votes (witness (bs m))))) :=
  fun (p : Liq) (bs : Member -> Ballot) => fun (i : I) => decide p (tallyLaw bs @ i)

-- Entries for `langc eval`.
def addOne : Liq := inl (pair (szS sz0) (szS sz0))
def yesNoYes : Member -> Votes := fun (m : Member) =>
  either (fun (u : Unit) => oneHot (inl unit)) (fun (r : Sum Unit Unit) => either (fun (u : Unit) => oneHot (inr unit)) (fun (u : Unit) => oneHot (inl unit)) r) m
def yesNoNo : Member -> Votes := fun (m : Member) =>
  either (fun (u : Unit) => oneHot (inl unit)) (fun (r : Sum Unit Unit) => oneHot (inr unit)) m
def countAt : Votes := count yesNoYes
def decideYes : Decision := decide addOne (count yesNoYes)
def decideNo : Decision := decide addOne (count yesNoNo)
def tallied : Enc Votes := tallyEnc (ballotsAt (inl unit) (inr unit) (inl unit))
